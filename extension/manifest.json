{
  "manifest_version": 3,
  "name": "SlackPolish",
  "version": "1.6.2",
  "description": "SlackPolish hotkey logger: records where Ctrl+Shift is pressed (Slack, Atlassian/Jira, other) and the text of the focused editor - the first step toward polishing outside Slack.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SlackPolish hotkey log"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/hotkey.js",
        "shared/surface.js",
        "shared/status-badge.js",
        "shared/editor.js",
        "content/hotkey-logger.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
